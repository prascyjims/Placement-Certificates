{
  "name": "pl_telecom_incremental_ingestion",
  "properties": {
    "parameters": {
      "sourceFolder": {
        "type": "String",
        "defaultValue": "telecom"
      },
      "watermarkDate": {
        "type": "String",
        "defaultValue": "2026-08-07"
      }
    },
    "activities": [
      {
        "name": "Get_Metadata_Source_Files",
        "type": "GetMetadata",
        "typeProperties": {
          "fieldList": [
            "childItems"
          ]
        }
      },
      {
        "name": "Lookup_Watermark",
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT MAX(usage_date) AS watermarkDate FROM gold_usage"
          }
        }
      },
      {
        "name": "ForEach_Source",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Get_Metadata_Source_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Lookup_Watermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@array('customers','plans','usage')",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "Copy_To_ADLS",
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "SourceDataset"
                },
                "sink": {
                  "type": "AzureBlobFSSink"
                },
                "incrementalColumn": "usage_date",
                "watermark": "@pipeline().parameters.watermarkDate"
              }
            }
          ]
        }
      }
    ]
  }
}